#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        hyphen_arrow: hyphen_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "HYPHEN_ARROW";
        };

        thick_arrow: thick_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp GT>;
            label = "THICK_ARROW";
        };

        gpoi: gpoi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp L &kp L &kp SPACE &kp O &kp R &kp I &kp G &kp I &kp N &kp SPACE &kp I &kp N &kp T &kp E &kp G &kp R &kp A &kp T &kp I &kp O &kp N>;
            label = "GPOI";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1       &kp N2                  &kp N3       &kp N4       &kp N5       &tog 1                                                                   &mo 4          &kp N6       &kp N7   &kp N8     &kp N9    &kp N0             &hm F12 MINUS
&kp TAB    &kp Q        &hm LC(W) W             &kp E        &hm LC(R) R  &hm LC(T) T  &kp PLUS                                                                 &kp MINUS      &kp Y        &kp U    &kp I      &kp O     &kp P              &kp BSLH
&kp ESC    &hm LC(A) A  &hm LC(S) S             &hm LC(D) D  &hm LC(F) F  &lt 2 G      &kp EQUAL  &kp LCTRL  &kp LALT             &kp LEFT_WIN     &kp RCTRL    &kp DOLLAR     &lt 2 H      &lt 2 J  &kp K      &kp L     &kp SEMI           &kp SQT
&kp LSHFT  &hm LC(Z) Z  &hm LC(X) X             &hm LC(C) C  &hm LC(V) V  &kp B                              &kp LC(LA(DEL))      &kp PRINTSCREEN                              &hm LC(N) N  &kp M    &kp COMMA  &kp DOT   &hm LC(FSLH) FSLH  &kp RSHFT
&mo 2      &kp GRAVE    &hm LS(LC(LA(C))) CAPS  &kp LEFT     &kp RIGHT                 &kp BSPC   &lt 3 DEL  &kp END              &kp LG(LS(S))    &lt 3 ENTER  &hm TAB SPACE               &kp UP   &kp DOWN   &kp LBKT  &kp RBKT           &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4     &kp F5               &kp F6     &tog 1                                                        &mo 4   &kp F7     &kp F8                  &kp F9              &kp F10                  &kp F11  &kp F12
&trans  &trans     &kp LC(W)  &trans     &kp LC(R)            &kp LC(T)  &none                                                         &none   &trans     &kp LC(LEFT_ARROW)      &kp UP_ARROW        &kp LC(RIGHT_ARROW)      &trans   &trans
&trans  &kp LC(A)  &kp LC(S)  &kp LC(D)  &hm LS(LC(F)) LC(F)  &trans     &none              &trans  &trans      &trans  &trans         &none   &trans     &kp LEFT_ARROW          &kp DOWN_ARROW      &kp RIGHT                &trans   &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)            &trans                                &trans      &trans                         &kp LC(N)  &kp LS(LC(LEFT_ARROW))  &kp LS(UP_ARROW)    &kp LS(LC(RIGHT_ARROW))  &trans   &trans
&trans  &trans     &trans     &trans     &trans                          &kp LC(BACKSPACE)  &trans  &trans      &trans  &kp LC(ENTER)  &trans             &kp LS(LEFT_ARROW)      &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)      &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0                &bt BT_SEL 1                    &bt BT_SEL 2                   &bt BT_SEL 3                            &bt BT_SEL 4        &trans                                                   &trans        &trans           &trans                 &trans           &trans             &trans                         &trans
&trans          &trans                      &hm GRAVE GRAVE                 &hm SINGLE_QUOTE SINGLE_QUOTE  &hm DOUBLE_QUOTES DOUBLE_QUOTES         &kp EXCLAMATION     &bootloader                                              &bootloader   &kp AMPERSAND    &kp EQUAL              &kp PLUS         &kp MINUS          &trans                         &trans
&studio_unlock  &hm GREATER_THAN LESS_THAN  &hm RIGHT_BRACKET LEFT_BRACKET  &hm RIGHT_BRACE LEFT_BRACE     &hm RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp QUESTION        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT  &kp EXCLAMATION  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &hm GREATER_THAN GREATER_THAN  &trans
&trans          &hm PLUS PLUS               &hm UNDERSCORE MINUS            &hm ASTERISK ASTERISK          &hm BACKSLASH KP_DIVIDE                 &hm PIPE BACKSLASH                       &trans      &trans                                &kp PIPE         &kp SQT                &kp COMMA        &kp PERIOD         &hm COLON SEMI                 &trans
&kp LEFT_SHIFT  &trans                      &trans                          &trans                         &trans                                                      &trans       &trans  &trans      &trans      &bl BL_TOG  &trans                         &bl BL_INC             &bl BL_DEC       &trans             &trans                         &kp LEFT_SHIFT
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
